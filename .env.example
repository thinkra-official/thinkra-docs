APP_NAME="Thinkra Docs"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost
# Optional: force all public CSS/JS to reload after deploy (e.g. 20260604). Leave empty to use file dates.
# APP_ASSET_VERSION=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ar_SA

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=thinkra_docs
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=thinkra_docs

# First Super Admin (used by AdminUserSeeder when run)
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_EMAIL=admin@thinkra.test
SUPER_ADMIN_PASSWORD=ChangeMe123!
